PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/projectscope_ai?schema=public"

# Auth and access control
AUTH_ENABLED=false
AUTH_LOGIN_PASSWORD="dev-password"
AUTH_TOKEN_SECRET="local-dev-token-secret-1234"
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_SUPERADMIN_ACTOR_IDS="local-dev-actor"
AUTH_ADMIN_ACTOR_IDS=""

# API security and networking
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Optional: enable Azure OpenAI for real estimation generation.
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com"
AZURE_OPENAI_API_KEY="your-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_TIMEOUT_MS=25000

# Reference pricing per 1K tokens (adjust to your deployed model pricing).
AZURE_OPENAI_INPUT_COST_PER_1K=0.005
AZURE_OPENAI_OUTPUT_COST_PER_1K=0.015
