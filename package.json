{
  "name": "ai-study-buddy",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean-modules": "rm -rf node_modules .turbo apps/*/node_modules apps/*/.expo apps/*/.turbo apps/*/dist libs/*/node_modules libs/*/.turbo libs/*/dist libs/*/storybook-static",
    "clean-watchman": "watchman watch-del-all",
    "clean": "pnpm clean-modules && pnpm clean-watchman"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}