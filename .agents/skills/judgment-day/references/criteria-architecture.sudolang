# SudoLang Architecture & Design Criteria Module

ArchitectureAuditor {
  state {
    findings: []
  }

  function evaluate(targetCodeOrDiagram) {
    log("Iniciando revisión adversarial de arquitectura y diseño...")
    
    checkLayerDecoupling(targetCodeOrDiagram)
    checkArchitecturalPatterns(targetCodeOrDiagram)
    checkNamingAndConventions(targetCodeOrDiagram)
    checkDiagramConsistency(targetCodeOrDiagram)
    
    return compileArchitectureReport()
  }

  function checkLayerDecoupling(code) {
    // Detect layer violations (e.g. database access in UI layer or direct model import in view)
    find(imports or references in code) {
      if (violatesCleanArchitecture(reference)) {
        addFinding("CRITICAL", "Violación de la separación de capas (clean architecture / acoplamiento)", reference)
      }
    }
  }

  function checkArchitecturalPatterns(code) {
    // Verify design patterns are correctly implemented
    find(patterns in code) {
      if (incorrectlyImplemented(patterns)) {
        addFinding("WARNING (real)", "Uso incorrecto o inconsistente de un patrón de diseño arquitectónico", patterns)
      }
    }
  }

  function checkNamingAndConventions(code) {
    // Audit naming style, prefixes, suffix matches, project guidelines
    find(declarations in code) {
      if (violatesProjectNamingStandard(declarations)) {
        addFinding("SUGGESTION", "Nombre de variable, clase o función no cumple con la nomenclatura estándar", declarations)
      }
    }
  }

  function checkDiagramConsistency(document) {
    // Verify diagrams match code, or use correct Mermaid markup syntax
    if (isMermaidDiagram(document)) {
      if (hasSyntaxErrors(document) or isInvalidC4Model(document)) {
        addFinding("WARNING (real)", "Diagrama Mermaid mal estructurado o con errores de sintaxis", document)
      }
    }
  }

  function addFinding(severity, issue, context) {
    findings.append({
      severity: severity,
      issue: issue,
      context: context,
      description: "Incumplimiento de las directrices de diseño y arquitectura del sistema."
    })
  }

  function compileArchitectureReport() {
    if (findings.length == 0) {
      return { verdict: "CLEAN", findings: [] }
    }
    return { verdict: "FLAGGED", findings: findings }
  }
}
