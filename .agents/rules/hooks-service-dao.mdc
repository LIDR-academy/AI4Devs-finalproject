## Examples

### Complete Example: Audit Service

**DAO** (`profile.dao.ts`):

```typescript
import { getSupabase } from '../supabase/supabase-client';

export abstract class ProfileDao {
  static async getProfile(id: number): Promise<ProfileDto> {
    const { data, error } = await getSupabase()
      .from('profiles')
      .select('*')
      .eq('id', id)
      .single();
    if (error) throw error;
    return data;
  }
}
```

**Service** (`profile.service.ts`):

```typescript
export abstract class ProfileService {
  static getProfile(id: number): Promise<ProfileDto> {
    if (!id) {
      return Promise.reject(new Error("Missing id parameter"));
    }
    return ProfileDao.getProfile(id);
  }
}
```

**Hook** (`use-get-profile.ts`):

```typescript
export const useGetProfile = () => {
  const { id } = useId();

  return useQuery({
    queryKey: ['profile', id],
    queryFn: () => ProfileService.getProfile(id),
  });
};
```

**Component Usage**:

```typescript
function MyComponent() {
  const { isLoading, data, error } = useGetProfile();

  if (isLoading) {
    return <LoadingComponent />
  }

  if (error) {
    return <ErrorComponent error={error}/>
  }

  return <SomeComponent data={data}>;
}
```

