# Copiar a .env y ajustar (docker compose carga .env automáticamente).
# La contraseña del rol `keycloak` en PostgreSQL está fijada en init/postgres/01-init.sql;
# si cambias KEYCLOAK_DB_PASSWORD aquí, debes alinear la misma contraseña en ese SQL y recrear el volumen de Postgres.

# PostgreSQL (BD aplicación: mtl; esquemas catalog, media, notification, ai + PostGIS)
POSTGRES_USER=mtl
POSTGRES_PASSWORD=mtl_dev_password
POSTGRES_DB=mtl
POSTGRES_PORT=5432

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mtl
MONGO_INITDB_ROOT_PASSWORD=mtl_mongo_dev_password
MONGO_PORT=27017

REDIS_PORT=6379

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Kafka: clientes en el host usan el puerto EXTERNAL (9094); dentro de Docker usan kafka:9092
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_HOST=9094

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password
