# QuickChat — local environment configuration (home-stream-lifecycle-v0).
# Copy to .env and adjust if needed:  cp .env.example .env
#
# These are NON-SECRET local-dev defaults. No secrets belong here or in .env:
# for this slice Valkey runs anonymous and ephemeral, so there is nothing to hide.
# .env is git-ignored; .env.example is committed as the documented source of truth.

# --- Images (pinned; never use :latest) ---
VALKEY_IMAGE=valkey/valkey:8.1-alpine
NGINX_IMAGE=nginx:1.27-alpine

# --- Single browser-facing origin (the reverse proxy) ---
# Open http://localhost:${PROXY_PORT} in your browser. This is the ONLY exposed port.
PROXY_PORT=8080

# --- Portal static server (internal only; reached via the proxy) ---
PORTAL_PORT=3000

# --- Streamer runtime config (internal only; passed verbatim to the streamer service) ---
# Names owned by streamer; supplied here exactly as streamer reads them.
VALKEY_ADDR=valkey:6379
VALKEY_PASSWORD=
VALKEY_DB=0
STREAMER_ADDR=:8080

# --- Chat knobs (room-chat-v0; non-secret; read by streamer) ---
# CHAT_MAX_MESSAGES: per-room ring-buffer cap (drop-oldest).
# CHAT_PAGE_SIZE:    history page size / cap for GET /streams/{id}/messages.
# CHAT_MAX_LENGTH:   max characters per chat message (server-enforced).
CHAT_MAX_MESSAGES=1000000
CHAT_PAGE_SIZE=200
CHAT_MAX_LENGTH=500

# --- LiveKit media (stream-media-v0) ---
# LiveKit image pin + published ports. LiveKit is a SECOND browser-facing origin
# (WebRTC can't traverse nginx): 7880 WS signaling, 7881 TCP fallback, 7882 UDP mux.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.4
LIVEKIT_WS_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# LiveKit credentials + URLs read by streamer.
# !!! DEV-ONLY !!! These are the well-known LiveKit dev key/secret — NOT secrets to
# protect, but do NOT promote them to any real deployment. The same pair is used by
# LiveKit's --dev mode, so streamer's tokens validate against the server.
# LIVEKIT_URL is server-to-server (internal HTTP/Twirp API); LIVEKIT_PUBLIC_URL is
# browser-facing (WebRTC signaling) and is what streamer returns in the token `url`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Dev TURN (coturn, stream-media-v0) ---
# Relays real-browser media over TCP where the direct WebRTC path is unreliable
# (Docker Desktop macOS). DEV-ONLY, plain TCP, no TLS. Static creds live in
# coturn.conf (devuser/devpass) and are advertised to browsers via livekit.yaml
# turn_servers. Only the control port 3478 is published; relay ports stay internal.
# Media verified on Chrome, Brave, Safari. Firefox media is a known v0 limitation
# (does not connect in this dev-mode setup) — see README. Chat/app work in all.
COTURN_IMAGE=coturn/coturn:4.6.2
TURN_PORT=3478
