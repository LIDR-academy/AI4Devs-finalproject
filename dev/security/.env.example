# security service configuration — NAMES ONLY, no real values.
# Copy to an untracked .env and fill in. The API key is a secret: never commit it.

# SuperTokens managed cloud (human-supplied).
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=

# This service's public API domain (where /auth is served) and the portal origin.
SECURITY_API_DOMAIN=
SECURITY_WEBSITE_DOMAIN=

# Full URL of the users service internal endpoint (compose-internal).
USERS_GET_OR_CREATE_URL=

# Optional (defaults shown).
SECURITY_API_BASE_PATH=/auth
SECURITY_APP_NAME=QuickChat
PORT=8080
