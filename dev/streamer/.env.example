# Streamer service configuration (copy to .env for local runs; never commit .env).
# VALKEY_ADDR and SECURITY_JWKS_URL are required; the rest have defaults.

# Valkey host:port (required). In compose this is the Valkey service name.
VALKEY_ADDR=valkey:6379

# security's JWKS endpoint (required). Used to verify Bearer access tokens locally
# (RS256, key matched by kid, background-refreshed) — no per-request call to security.
# Only the public JWKS crosses this boundary; no SuperTokens secret reaches streamer.
SECURITY_JWKS_URL=http://security:8080/auth/jwt/jwks.json

# Valkey password (optional; empty when Valkey runs without auth).
VALKEY_PASSWORD=

# Valkey logical database index (optional; default 0).
VALKEY_DB=0

# HTTP listen address (optional; default ":8080").
STREAMER_ADDR=:8080

# Chat knobs (optional; positive integers).
# Per-room message ring-buffer cap (drop-oldest).
CHAT_MAX_MESSAGES=1000000
# History page size and the cap on a requested limit.
CHAT_PAGE_SIZE=200
# Maximum message length in Unicode code points.
CHAT_MAX_LENGTH=500

# LiveKit (media) configuration — all required.
# API key/secret (dev-only values in local compose; the secret is never logged or returned).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Server-to-server LiveKit API URL (streamer → LiveKit).
LIVEKIT_URL=http://livekit:7880
# Browser-facing LiveKit URL (returned to clients in the media token).
LIVEKIT_PUBLIC_URL=ws://localhost:7880
