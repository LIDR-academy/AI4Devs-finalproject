# Docker Compose environment variables (example)
# Copy to `.env` in the project root and set real values. Never commit `.env`.
# (Backend has its own .env in Backend/ for running the app without Docker.)

# PostgreSQL (used by postgres service and by backend container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=travelsplit

# JWT (used by backend container). Minimum 32 characters in production.
JWT_SECRET=
