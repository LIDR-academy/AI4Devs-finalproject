# --- Django core ---------------------------------------------------------
SECRET_KEY=change-me-in-every-environment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (EyeMaster's own PostgreSQL) --------------------------------
# Leave unset to fall back to local sqlite for quick starts.
DATABASE_URL=postgresql://eyemaster:eyemaster@localhost:5432/eyemaster
POSTGRES_DB=eyemaster
POSTGRES_USER=eyemaster
POSTGRES_PASSWORD=eyemaster

# --- ERP connectivity (see readme.md §2, documentacion-funcional.md §5.3) -
# ERP_MODE=mock simulates the ERP webservices with local fixtures; no
# ADMIN_*/PEOPLE_* values are required in that mode.
ERP_MODE=mock
ADMIN_API_URL=
ADMIN_API_TOKEN=
PEOPLE_API_URL=
PEOPLE_API_TOKEN=
ERP_HTTP_TIMEOUT_SECONDS=5
ERP_HTTP_MAX_RETRIES=2
ERP_CIRCUIT_BREAKER_THRESHOLD=5
ERP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
