# 🌐 RestoStock — Configuración de Entorno (Plantilla)

# Copia este archivo como '.env' en la raíz del proyecto y configura tus valores locales.
# Queda prohibido confirmar (commit) el archivo '.env' real al repositorio.

# 🔌 Conexión a Base de Datos (PostgreSQL)
# Prisma ORM utiliza esta variable para conectarse a la base de datos de desarrollo/producción.
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/restostock_db?schema=public"

# 🚪 Servidor Express
# Puerto de escucha del backend (por defecto 3000 según TK-001/backend-rules)
PORT=3000
NODE_ENV="development" # Valores posibles: development, test, production

# 🔑 Seguridad y Autenticación
# Clave secreta para firmar y validar los tokens JWT emitidos (vigencia de 12 horas)
JWT_SECRET="reemplazar_con_un_secreto_seguro_y_largo_en_produccion"

# 🧪 Base de Datos Efímera para Pruebas (Opcional)
# Utilizada durante la ejecución de los tests de integración en local/CI
TEST_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5433/restostock_test_db?schema=public"
