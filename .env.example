# Sport ITSM API — environment template.
#
# Copy to `.env` at the repository root and adjust. Every key below is
# MANDATORY and has no in-code default: the API validates this environment at
# boot (`apps/api/src/config/env.validation.ts`) and refuses to start when a
# key is missing or malformed, naming the offending key.
#
# Keys are added here as the capabilities that need them land — the database
# connection with T-C10-16, observability with T-C10-28.

# Deployment environment: development | test | staging | production
NODE_ENV=development

# TCP port the HTTP server binds to (1-65535).
PORT=3000
