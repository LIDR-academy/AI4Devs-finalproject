# INK·LINK — variables de entorno para docker-compose
# Copia este archivo como `.env` (gitignored) y completa los valores reales.
# NUNCA commitees el archivo .env ni pegues estas claves en el código fuente.

# Flow (pasarela de pago) — credenciales del sandbox: https://sandbox.flow.cl
# Con FLOW_USE_MOCK=true la API usa el mock y las claves no son necesarias.
FLOW_USE_MOCK=true
FLOW_API_KEY=
FLOW_SECRET_KEY=
