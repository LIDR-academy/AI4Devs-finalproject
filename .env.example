# Realista — environment variables (root)
# Copy to .env and fill in. Never commit .env.

# Database
# Port 5432 inside the container. On the host, docker-compose maps
# it to 5433 (because some machines already have another postgres
# on 5432 — change to 5432 here if you have a clean port).
DATABASE_URL=postgresql://realista:realista@localhost:5433/realista?schema=public

# Backend
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# OpenRouter (get yours at https://openrouter.ai/keys)
# Default: deepseek/deepseek-v4-flash. The adapter sends
# reasoning: { effort: "none" } to disable costly auto-reasoning.
# See https://openrouter.ai/docs/guides/best-practices/reasoning-tokens
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Rate limiting (FR-010)
RATE_LIMIT_PER_DAY=20

# External services
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
CATASTRO_BASE_URL=https://ovc.catastro.meh.es/ovcservweb/OVCSWLocalizacionRC/OVCCallejero.asmx
REALISTA_USER_AGENT=Realista/1.0 (analizador educativo)
ALLOWED_PORTALS=idealista.com,fotocasa.es,habitaclia.com,pisos.com,milanuncios.com

# Health check (FR-027)
HEALTH_CHECK_CRON=*/30 * * * *

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=Realista
VITE_APP_VERSION=0.2.0

# Testing (uncomment to mock external APIs in tests)
# MOCK_OPENROUTER=true
# MOCK_NOMINATIM=true
# MOCK_CATASTRO=true
