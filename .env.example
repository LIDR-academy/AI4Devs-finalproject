# Copy to .env and adjust. Used by the FastAPI backend (pydantic-settings).

# --- Persistence ---
DATABASE_URL=postgresql://auditcare:auditcare@localhost:5433/auditcare_app

# --- Statewave (contextual memory + provenance) ---
STATEWAVE_URL=http://localhost:8100
STATEWAVE_API_KEY=
# Advanced (defaults match the Statewave v1 API contract):
# STATEWAVE_EPISODE_PATH=/v1/episodes
# STATEWAVE_COMPILE_PATH=/v1/memories/compile
# STATEWAVE_CONTEXT_PATH=/v1/context
# STATEWAVE_SUBJECT_PREFIX=patient
# STATEWAVE_CONTEXT_MAX_TOKENS=1800

# --- AI extraction LLM (optional, OpenAI-compatible) ---
# If empty, the backend uses a deterministic rule-based extractor so the
# MVP stays fully executable offline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
