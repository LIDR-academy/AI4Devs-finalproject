DATABASE_URL=postgresql://mecatrack:mecatrack@localhost:5434/mecatrack
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Set to false when serving over HTTP (e.g. local Docker on localhost)
# COOKIE_SECURE=false

# US-D4 / shared email (console adapter)
EMAIL_ENABLED=false
EMAIL_PROVIDER=console
WORKSHOP_NAME=Taller
