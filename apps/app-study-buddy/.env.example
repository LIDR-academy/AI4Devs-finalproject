# Local: copy to .env.development (used by expo start)
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<local anon from `supabase status`>

# Production: copy to .env.production (used by scripts/deploy-web.sh)
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<hosted anon / publishable key>
