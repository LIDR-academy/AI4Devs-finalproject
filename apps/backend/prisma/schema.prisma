// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // linux-musl-openssl-3.0.x: node:24-alpine (Alpine 3.24) solo trae libssl.so.3 — el
  // motor musl por defecto de Prisma 5.x enlaza contra OpenSSL 1.1, ausente en esta base
  // (bug detectado al arrancar el contenedor por primera vez, TK-042/Guard 23).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KITCHEN_STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RemanenteStatus {
  ACTIVE
  EXHAUSTED
  DISCARDED
}

model User {
  id             String     @id @default(uuid())
  name           String
  role           Role       @default(KITCHEN_STAFF)
  pinHash        String
  status         UserStatus @default(ACTIVE)
  failedAttempts Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Insumo {
  id              String           @id @default(uuid())
  name            String
  unitOfMeasure   String           @default("KG")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  warehouseStocks WarehouseStock[]
  remanentes      Remanente[]
  stockMovements  StockMovement[]
}

model WarehouseStock {
  id        String   @id @default(uuid())
  insumoId  String
  location  String   @default("MAIN_WAREHOUSE")
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt
  insumo    Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
}

model Remanente {
  id              String          @id @default(uuid())
  insumoId        String
  currentQuantity Decimal         @default(0) @db.Decimal(12, 3)
  initialQuantity Decimal         @default(0) @db.Decimal(12, 3)
  location        String          @default("KITCHEN_FRIDGE")
  status          RemanenteStatus @default(ACTIVE)
  expirationDate  DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  insumo          Insumo          @relation(fields: [insumoId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id        String   @id @default(uuid())
  insumoId  String
  type      String   // EXTRACTION, DISCARD, RECONCILIATION
  quantity  Decimal  @db.Decimal(12, 3)
  fromLoc   String
  toLoc     String
  createdAt DateTime @default(now())
  insumo    Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
}

model SystemHealth {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now())
}
