// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7 (TK-062): sin motor Rust — requiere un driver adapter (@prisma/adapter-pg)
  // en el constructor de PrismaClient. moduleFormat = "cjs" evita migrar todo el backend
  // a ESM (el resto del proyecto sigue en CommonJS/NodeNext tal como estaba).
  provider     = "prisma-client"
  moduleFormat = "cjs"
  // Dentro de src/ a proposito (no ../generated) — tsconfig.json fija rootDir=./src
  // (Guard 12), y ampliarlo para incluir una carpeta hermana rompe la estructura de
  // dist/. Generando aqui, tsc lo compila junto con el resto de src/ sin tocar tsconfig.
  output       = "../src/generated/prisma"
}

datasource db {
  // La URL de conexion se movio a prisma.config.ts (Prisma 7 ya no soporta `url` aqui).
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum LocationType {
  WAREHOUSE
  KITCHEN
}

enum RemanenteStatus {
  ACTIVE
  EXHAUSTED
  DISCARDED
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  module      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                String          @id @default(uuid())
  name              String
  roleId            String?
  role              Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  pinHash           String
  status            UserStatus      @default(ACTIVE)
  mustChangePin     Boolean         @default(true)
  failedAttempts    Int             @default(0)
  email             String?         @unique
  resetTokenHash    String?
  resetTokenExpires DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockMovements    StockMovement[]
}


model StorageLocation {
  id              String           @id @default(uuid())
  name            String           @unique
  type            LocationType     @default(KITCHEN)
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // US-025: existencias de bodega alojadas en este sub-sector
  warehouseStocks WarehouseStock[]
  // US-026: remanentes de cocina ubicados en esta área (type = KITCHEN)
  remanentes      Remanente[]
}

model SystemSettings {
  id                       String   @id @default("default")
  restaurantName           String   @default("RestoStock Kitchen")
  taxId                    String?
  currencySymbol           String   @default("$")
  criticalAlertHours       Int      @default(24)
  defaultRemanenteHours    Int      @default(24)
  varianceTolerancePercent Decimal  @default(5.0) @db.Decimal(5, 2)
  idleTimeoutMinutes       Int      @default(15)
  updatedAt                DateTime @updatedAt
}


model Insumo {
  id              String           @id @default(uuid())
  name            String
  unitOfMeasure   String           @default("KG")
  unitCost        Decimal?         @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  warehouseStocks WarehouseStock[]
  remanentes      Remanente[]
  stockMovements  StockMovement[]
}

model WarehouseStock {
  id                String          @id @default(uuid())
  insumoId          String
  storageLocationId String
  quantity          Decimal         @default(0) @db.Decimal(12, 3)
  updatedAt         DateTime        @updatedAt
  insumo            Insumo          @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  // US-025: RESTRICT — un sub-sector con existencias no puede borrarse (Invariante 1-bis)
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@unique([insumoId, storageLocationId])
  @@index([storageLocationId])
}

model Remanente {
  id              String          @id @default(uuid())
  insumoId        String
  currentQuantity Decimal         @default(0) @db.Decimal(12, 3)
  initialQuantity Decimal         @default(0) @db.Decimal(12, 3)
  // US-026: caché denormalizado de display/movimiento (= name del área). La fuente
  // canónica de la ubicación es storageLocationId cuando está presente.
  location        String          @default("KITCHEN_FRIDGE")
  // US-026: FK al área de cocina del catálogo (type = KITCHEN). Nullable: los remanentes
  // históricos conservan solo el literal en `location`. RESTRICT: un área con remanentes
  // ACTIVE no puede borrarse (Invariante 5).
  storageLocationId String?
  status          RemanenteStatus @default(ACTIVE)
  expirationDate  DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  terminalAt      DateTime?
  insumo          Insumo          @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@index([storageLocationId])
}

model StockMovement {
  id         String   @id @default(uuid())
  insumoId   String
  type       String   // EXTRACTION, DISCARD, RECONCILIATION, RESTOCK, EXTRACTION_RECIPE, DISCARD_DIRECT
  quantity   Decimal  @db.Decimal(12, 3)
  fromLoc    String
  toLoc      String
  operatorId String?
  purpose    String?  // KITCHEN_STOCK, RECIPE, DIRECT_DISCARD
  reason     String?  // Motivo descriptivo de extracción o descarte directo
  recipeId   String?  // ID de receta asociada si purpose == RECIPE
  createdAt  DateTime @default(now())
  insumo     Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  operator   User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
}

model SystemHealth {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now())
}

model Recipe {
  id          String             @id @default(uuid())
  name        String
  category    String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id       String  @id @default(uuid())
  recipeId String
  insumoId String
  quantity Decimal @db.Decimal(12, 4)
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model ShiftReconciliation {
  id         String                    @id @default(uuid())
  shiftDate  DateTime
  operatorId String
  notes      String?
  createdAt  DateTime                  @default(now())
  items      ShiftReconciliationItem[]
}

model ShiftReconciliationItem {
  id                  String              @id @default(uuid())
  reconciliationId    String
  remanenteId         String
  insumoId            String
  physicalQuantity    Decimal             @db.Decimal(12, 4)
  theoreticalQuantity Decimal             @db.Decimal(12, 4)
  variance            Decimal             @db.Decimal(12, 4)
  reconciliation      ShiftReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
}
