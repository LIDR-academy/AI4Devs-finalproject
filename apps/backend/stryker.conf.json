{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "!src/domain/**/*.test.ts",
    "!src/application/**/*.test.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  }
}
