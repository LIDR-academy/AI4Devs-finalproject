# ==============================================================================
# RestoStock Backend Environment Configuration Template (.env.example)
# Copy this template to .env before starting the application locally
# ==============================================================================

# Server HTTP Port
PORT=3000

# Application Environment (development | test | production)
NODE_ENV=development

# Security JWT Signing Secret (Replace with a strong secret key min 32 chars)
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS"

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_POSTGRES_DB?schema=public"

# CORS Allowed Origins (Comma-separated or * for wildcard dev)
CORS_ALLOWED_ORIGINS="*"

# Rate Limiting Controls (Window in ms, Max requests per REAL client IP — needs trust proxy, AUDIT-SEC-003)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Login / forgot-pin / reset-pin anti-brute-force (Guard 16). Raise for shared-NAT sites (several terminals behind one IP).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

