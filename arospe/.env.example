APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This app's real runtime database is MySQL (see compose.yaml / docs/architecture/overview.md) —
# never SQLite. DB_HOST=mysql is Sail's service name from compose.yaml, required for the app
# container to reach the mysql container over the Sail Docker network; it is not a secret.
# DB_DATABASE/DB_USERNAME/DB_PASSWORD are intentionally left unset here — per the README, the
# working values are requested privately from Angel, never guessed or invented.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Email of the user RolePermissionSeeder assigns the Super Admin role to. Leave unset to
# seed the role unassigned. If it matches an existing VERIFIED user, that user is granted
# the role. If it matches no existing user, the seeder PROVISIONS a new account for it with
# a random password and emails a password-reset link so the operator can claim it via
# "Forgot password". If it matches an existing but UNVERIFIED user, the seeder ABORTS the
# bootstrap loudly and grants the role to nobody — have that account's owner verify their
# email address, or free up the address, then re-run the seeder. If the value is not a
# well-formed email address, the seeder ABORTS the bootstrap loudly, naming the invalid
# value — correct it and re-run the seeder. The value is normalized to lowercase before
# use, so "Admin@Example.com" and "admin@example.com" are the same address. Use an
# ASCII-only address.
# SUPER_ADMIN_EMAIL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
