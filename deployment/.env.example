# =============================================================================
# IPFS Gateway — Deployment Environment Variables
# =============================================================================
# Copy this file to deployment/.env and fill in all required values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ---- Application ----
APP_ENV=production
APP_SETTINGS_MODULE=config.production.ProductionConfig
APP_DEBUG=false
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ---- Container Registry Images (Production compose) ----
PRIVATE_DOCKER_REPOSITORY=CHANGE_TO_YOUR_DOCKER_REGISTRY
# Resulting images:
# - CHANGE_TO_YOUR_DOCKER_REGISTRY:ipfs-gateway-prod-backend-latest
# - CHANGE_TO_YOUR_DOCKER_REGISTRY:ipfs-gateway-prod-celery-latest
# - CHANGE_TO_YOUR_DOCKER_REGISTRY:ipfs-gateway-prod-frontend-latest
# - CHANGE_TO_YOUR_DOCKER_REGISTRY:ipfs-gateway-prod-nginx-latest

# ---- Database (PostgreSQL) ----
POSTGRES_USER=ipfs_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=ipfs_gateway
# Full DSN — automatically composed from the values above in compose files
DATABASE_URL=postgresql://ipfs_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ipfs_gateway
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_FAILED_TASKS_REDIS_URL=redis://redis:6379/1
CELERY_FAILED_TASKS_KEY=celery:failed_tasks
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# ---- Filebase / IPFS storage ----
FILEBASE_ACCESS_KEY=CHANGE_ME_FILEBASE_ACCESS_KEY
FILEBASE_SECRET_KEY=CHANGE_ME_FILEBASE_SECRET_KEY
FILEBASE_BUCKET=CHANGE_ME_FILEBASE_BUCKET
FILEBASE_ENDPOINT=https://s3.filebase.com

# ---- Security ----
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
ALLOWED_ORIGINS=https://your-domain.com
CORS_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,X-API-Key,X-Request-ID
CORS_EXPOSE_HEADERS=X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,Retry-After,X-Request-ID
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=false

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=300/hour
RATE_LIMIT_REGISTRATION=5/hour
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_RETRIEVE=100/hour
RATE_LIMIT_PINNING=50/hour
RATE_LIMIT_STATUS=10/hour
RATE_LIMIT_RENEW=10/hour
RATE_LIMIT_ADMIN=100/hour
RATE_LIMIT_TASKS=60/hour
RATELIMIT_HEADERS_ENABLED=true
RATELIMIT_STRATEGY=fixed-window

# ---- Misc ----
MAX_CONTENT_LENGTH=104857600
REQUEST_ID_HEADER=X-Request-ID
AUDIT_LOG_DEFERRED_WRITE=true
AUDIT_IP_RETENTION_DAYS=90
AUDIT_IP_REDACTION_MODE=mask
AUDIT_REDACTION_BATCH_SIZE=200
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_NAME=IPFS Gateway
