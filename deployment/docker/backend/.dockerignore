# Backend build context — exclude everything that is not needed in the image

# Virtual environments
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Test artefacts
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE / OS noise
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Local environment files (injected at runtime via compose / secrets)
.env
*.env
!.env.example

# Alembic auto-generated bytecode
migrations/**/__pycache__/

# SQLite dev database
*.db
*.sqlite3

# Logs
logs/
*.log

# Build / packaging artefacts
*.egg-info/
dist/
build/
*.whl

# Git
.git/
.gitignore
