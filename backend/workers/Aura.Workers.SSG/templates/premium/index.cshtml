@using Aura.Core.Models
@model Event

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.CoupleNames - Premium Wedding</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=@Model.FontFamily:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body class="premium-theme">
    <header class="hero">
        <div class="hero-content">
            <p class="subtitle">Join us to celebrate</p>
            <h1>@Model.CoupleNames</h1>
            <p class="date">@Model.EventDate.ToString("MMMM dd, yyyy")</p>
        </div>
    </header>

    <main>
        <section class="details premium-card">
            <h2>The Event</h2>
            <div class="details-inner">
                <div class="detail-row">
                    <span class="detail-label">Date:</span>
                    <span class="detail-value">@Model.EventDate.ToString("f")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Venue:</span>
                    <span class="detail-value">@Model.VenueName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Address:</span>
                    <span class="detail-value">@Model.VenueAddress</span>
                </div>
            </div>
        </section>

        <section class="rsvp-section premium-card">
            <h2>RSVP</h2>
            <p>Your presence is our greatest present. Please let us know if you can attend.</p>
            <a href="/rsvp" id="rsvp-btn" class="btn btn-primary">RSVP Now</a>
        </section>

        <section class="map-section premium-card">
            <h2>Location Map</h2>
            <iframe
                width="100%"
                height="400"
                frameborder="0" style="border:0; margin-bottom:20px; border-radius: 8px;"
                src="https://maps.google.com/maps?q=@System.Uri.EscapeDataString(Model.VenueAddress ?? "")&t=&z=13&ie=UTF8&iwloc=&output=embed" allowfullscreen>
            </iframe>
            <div class="actions">
                <a href="https://www.google.com/maps/dir/?api=1&destination=@System.Uri.EscapeDataString(Model.VenueAddress)" target="_blank" class="btn btn-secondary">Get Directions</a>
                <a href="#" id="add-to-calendar-btn" class="btn btn-secondary">Add to Calendar</a>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; @DateTime.UtcNow.Year @Model.CoupleNames</p>
    </footer>

    @{
        var eventJson = System.Text.Json.JsonSerializer.Serialize(new { name = Model.Name, date = Model.EventDate, venue = Model.VenueName, address = Model.VenueAddress });
    }
    <script src="app.js"></script>
    <script>
        window.eventData = @Raw(eventJson);
    </script>
</body>
</html>
