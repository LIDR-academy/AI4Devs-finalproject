# Railway backend variables
NODE_ENV="production"
PORT="${{PORT}}"

# Railway PostgreSQL plugin normally provides this variable.
DATABASE_URL="${{Postgres.DATABASE_URL}}"
DATABASE_SSL="true"

# Replace with the deployed frontend URL.
FRONTEND_URL="https://proyectofinal-production-daab.up.railway.app"
ALLOWED_ORIGINS="https://proyectofinal-production-daab.up.railway.app"

# Seed/demo defaults
DEFAULT_STORE_NAME="ComercIA Demo Store"
DEFAULT_STORE_PHONE="+573001112233"

# Optional. If omitted, payment links use FRONTEND_URL/pay.
PAYMENT_BASE_URL="https://proyectofinal-production-daab.up.railway.app/pay"

# Minutes after delivery scheduling before closing the chat if the lead does not reply.
CONVERSATION_CLOSE_AFTER_MINUTES=60

# Meta WhatsApp Cloud API
WHATSAPP_PROVIDER="meta"
META_GRAPH_API_VERSION="v20.0"
META_WHATSAPP_VERIFY_TOKEN="generate-a-long-random-token"
META_WHATSAPP_ACCESS_TOKEN="paste-meta-permanent-or-system-user-token"
META_WHATSAPP_PHONE_NUMBER_ID="paste-meta-phone-number-id"
META_APP_SECRET="paste-meta-app-secret"

# Optional AWS
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# OpenAI commercial chatbot
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"
