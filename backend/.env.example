# Firebase Cloud Messaging (push notifications)
# Prefer the JSON key string (single-line) on production hosts like Render.
# For local dev, either form works; FIREBASE_SERVICE_ACCOUNT_PATH may point at a local JSON file.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"coacher","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"coacher@coacher.iam.gserviceaccount.com",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-sa-key.json
