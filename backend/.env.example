# Realista Backend — Environment Variables (local dev example)
# Copy to .env and fill in your values. Never commit .env.

# Database (matches docker-compose.yml)
# Port 5432 inside the container. On the host, docker-compose maps
# it to 5433 (because some machines already have another postgres
# on 5432 — change to 5432 here if you have a clean port).
DATABASE_URL=postgresql://realista:realista@localhost:5433/realista?schema=public

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# LLM Provider (choose one)
# Option A: OpenRouter (default) — supports many models
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Option B: OpenCode Go (open encode subscription)
# Get your API key at https://opencode.ai/auth
# LLM_PROVIDER=opencode-go
# OPENCODE_GO_API_KEY=oc-go-your-key-here
# OPENCODE_GO_MODEL=deepseek-v4-flash

# Rate limiting (FR-010)
RATE_LIMIT_PER_DAY=20

# External services
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
CATASTRO_BASE_URL=https://ovc.catastro.meh.es/ovcservweb/OVCSWLocalizacionRC/OVCCallejero.asmx
REALISTA_USER_AGENT=Realista/1.0 (analizador educativo)
ALLOWED_PORTALS=idealista.com,fotocasa.es,habitaclia.com,pisos.com,milanuncios.com

# Health check (FR-027)
HEALTH_CHECK_CRON=*/30 * * * *

# Playwright headless-browser adapter (DataDome/Cloudflare bypass)
# Requires: npx playwright install chromium
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_POOL_SIZE=1
PLAYWRIGHT_BROWSER_TIMEOUT_MS=15000
PLAYWRIGHT_HEADLESS=true
